# ==============================================================
# Telegram Bot Configuration
# ==============================================================
# Obtain API_ID and API_HASH from https://my.telegram.org
API_ID=12345678
API_HASH=abcdef0123456789abcdef0123456789

# Obtain BOT_TOKEN from https://t.me/BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# ==============================================================
# Telegram Size Limits
# ==============================================================
# Telegram MTProto upload ceiling (default: 2000 MB in bytes)
# This is a per-attachment ceiling. Large sources are split; quality is preserved.
MAX_FILE_SIZE=2097152000
# Hard per-video-part ceiling in MiB, capped at 1700. A recovery copy grows
# alongside each upload and is deleted afterwards. Default 1500 MiB leaves
# room for the application on a 2 GB host.
VIDEO_PART_SIZE_MB=1500

# ==============================================================
# Performance & Speed Tuning (Optimized for 600 Mbps network)
# ==============================================================
# Number of parallel fragment downloads per video (8-16 recommended)
CONCURRENT_FRAGMENT_DOWNLOADS=16

# Maximum concurrent video downloads running simultaneously (RAM protection)
MAX_CONCURRENT_DOWNLOADS=1

# Default: direct CDN -> FFmpeg -> concurrent Telegram upload.
# One bounded recovery file grows alongside upload and is deleted afterwards.
# Keep FFmpeg installed. The full source video is never staged first.
# Audio conversion and unsupported fragment-only formats can still need disk.
STREAM_VIDEO_UPLOADS=true
# Abort a stalled stream after this many seconds without a complete upload chunk.
STREAM_READ_TIMEOUT=90
# Parallel Telegram upload connections (bounded in-memory chunk queue).
UPLOAD_WORKERS=4
# Replies overlap; numbering, encryption and socket writes remain ordered.
UPLOAD_REQUESTS_PER_CONNECTION=4
# Probe higher concurrency when the source buffer has data ready.
# Retain gains; back off when extra concurrency stops helping or errors occur.
UPLOAD_ADAPTIVE=true
UPLOAD_MAX_WORKERS=8
UPLOAD_MAX_REQUESTS_PER_CONNECTION=8
UPLOAD_TUNE_INTERVAL=5
# Resume capacity checks after a temporary backoff / unhelpful trial.
UPLOAD_RECOVERY_SECONDS=30
# External-stage deadlines. Retryable stages get the initial attempt + 2 retries.
# SendMedia reuses its uploaded file and random_id across all three attempts.
TRANSFER_STAGE_TIMEOUT=60
# Bound session/subprocess/relay cleanup and optional chat status updates.
TRANSFER_CLEANUP_TIMEOUT=10
TRANSFER_STATUS_TIMEOUT=10
# A thumbnail is optional: publish the video without it if it stalls.
THUMBNAIL_TIMEOUT=20
# Shared MTProto encryption/decryption worker threads (Pyrogram default was 1).
CRYPTO_WORKERS=4
# Let fast CDN reads run ahead of Telegram within a fixed RAM budget.
STREAM_BUFFER_MB=128
# Parallel small direct CDN ranges feed FFmpeg without a paid proxy.
STREAM_PARALLEL_DOWNLOADS=true
STREAM_DOWNLOAD_WORKERS=8
STREAM_DOWNLOAD_CHUNK_KB=2048
# Optional next-item metadata prefetch; videos still transfer in playlist order.
PREFETCH_PLAYLIST=false

# Minimum five seconds between transfer progress-bar edits.
PROGRESS_UPDATE_INTERVAL=5
# Runtime logs always go to the console and /logs; keep up to ~6 MiB on disk.
LOG_LEVEL=INFO
LOG_FILE=bot.log
# Use LOG_LEVEL=DEBUG for per-range diagnostics without MTProto wire dumps.

# Directory for temporary video and thumbnail processing
DOWNLOAD_DIR=./downloads

# Disk budget for audio / sources requiring the regular download-and-merge path.
DOWNLOAD_STORAGE_LIMIT_MB=1536
MIN_FREE_DISK_MB=128
# Streamed videos briefly use disk for their current part, capped by
# VIDEO_PART_SIZE_MB and available free space, then delete it after posting.

# ==============================================================
# Cloud Hosting & Health Checks (Render, Koyeb, Railway)
# ==============================================================
# PORT provided automatically by Render
PORT=8080
HOST=0.0.0.0
ENABLE_WEB_SERVER=true

# ==============================================================
# YouTube Authentication (Bypasses "Sign in to confirm you're not a bot")
# ==============================================================
# Export YouTube cookies from browser into Netscape format, or base64 encode them:
# COOKIES_DATA="# Netscape HTTP Cookie File\n..."
# COOKIES_FILE=cookies.txt

# Optional proxy for YouTube details ONLY. Video/audio always download directly.
# Supports a single proxy or comma-separated list for automatic failover & retry:
# YOUTUBE_PROXY=http://user-session-s1:pass@gate.busyip.com:18080,http://user-session-s2:pass@gate.busyip.com:18080
YOUTUBE_PROXY=
